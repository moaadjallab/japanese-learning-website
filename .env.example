# ---------------------------------------------------------------------------
# Environment variables. Copy to `.dev.vars` for local development with the
# Cloudflare runtime (pnpm dev reads .dev.vars through the platform proxy),
# and set the same names in Cloudflare (Workers → Settings → Variables & Secrets).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Build-time ---------------------------------------------------------------
# Public production URL (canonical URLs, sitemap, hreflang, Open Graph).
SITE_URL=https://www.example.com

# Public (inlined into client code at build time — not secret) -----------------
# Cloudflare Turnstile site key for the contact form. Leave empty to hide the widget (dev only).
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token. Leave empty to disable analytics (default).
PUBLIC_CF_ANALYTICS_TOKEN=

# Server secrets (runtime) ---------------------------------------------------
# Resend API key used by POST /api/contact (https://resend.com).
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Nihongo Academy <no-reply@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Cloudflare Turnstile secret key. Required in production for /api/contact.
TURNSTILE_SECRET_KEY=

# Optional hosted checkout links (e.g. a payment provider's hosted payment page).
# When set, "Confirm Subscription" sends the visitor there; when empty, the
# checkout shows a "payments are being activated" message. No fake payments.
CHECKOUT_URL_BASIC=
CHECKOUT_URL_PREMIUM=
CHECKOUT_URL_PRIVATE=
