---
/**
 * Detailed plan comparison. md+: a real <table> (row/column headers, sr-only text for icons).
 * Mobile: one <details> per plan listing every feature as included / not included.
 */
import Icon from '@/components/icons/Icon.astro';
import { buttonClass } from '@/components/ui/styles';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { COMPARISON_KEYS } from '@/lib/domain/types';
import { formatPrice } from '@/lib/pricing';
import { getPlans } from '@/lib/repositories/plans';
import { routes } from '@/lib/routes';

interface Props {
  lang: Locale;
  captionId?: string;
}
const { lang, captionId = 'compare-title' } = Astro.props;
const t = useTranslations(lang);
const plans = await getPlans();
---

<!-- Desktop / tablet table -->
<div class="hidden overflow-hidden rounded-card bg-surface-raised shadow-soft ring-1 ring-line md:block">
  <table class="w-full border-collapse text-start text-sm" aria-labelledby={captionId}>
    <thead>
      <tr class="border-b border-line">
        <th scope="col" class="w-2/5 p-5 text-start font-semibold text-fg-muted">{t('pricingPage.featureColumn')}</th>
        {
          plans.map((plan) => (
            <th scope="col" class:list={['p-5 text-center align-bottom', plan.highlighted && 'bg-sakura-soft']}>
              {plan.highlighted && <span class="mb-1 block text-xs font-semibold text-primary">{t('common.mostPopular')}</span>}
              <span class="block text-base font-bold text-fg">{plan.name[lang]}</span>
              <span class="mt-1 block font-normal text-fg-muted">
                <span dir="ltr" class="font-semibold text-fg">{formatPrice(plan, lang)}</span> {t('common.perMonth')}
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        COMPARISON_KEYS.map((key) => (
          <tr class="border-b border-line last:border-0 even:bg-washi/60">
            <th scope="row" class="p-4 ps-5 text-start font-medium text-fg">{t(`pricingPage.comparison.${key}`)}</th>
            {plans.map((plan) => (
              <td class:list={['p-4 text-center', plan.highlighted && 'bg-sakura-soft/60']}>
                {plan.comparison[key] ? (
                  <span class="inline-flex size-7 items-center justify-center rounded-full bg-primary text-on-primary">
                    <Icon name="check" size={14} strokeWidth={3} label={t('common.included')} />
                  </span>
                ) : (
                  <span class="inline-flex size-7 items-center justify-center text-stone-500">
                    <Icon name="x" size={16} label={t('common.notIncluded')} />
                  </span>
                )}
              </td>
            ))}
          </tr>
        ))
      }
      <tr>
        <th scope="row" class="p-4 ps-5 text-start font-medium text-fg">{t('common.billingFrequency')}</th>
        {plans.map((plan) => <td class:list={['p-4 text-center text-fg-muted', plan.highlighted && 'bg-sakura-soft/60']}>{t('common.monthly')}</td>)}
      </tr>
      <tr>
        <td class="p-5"></td>
        {
          plans.map((plan) => (
            <td class:list={['p-5 text-center', plan.highlighted && 'bg-sakura-soft/60']}>
              <a href={routes.checkout(lang, plan.id)} class={buttonClass(plan.highlighted ? 'primary' : 'secondary', 'sm', 'w-full')}>
                {t('common.subscribe')}
                <span class="sr-only">— {plan.name[lang]}</span>
              </a>
            </td>
          ))
        }
      </tr>
    </tbody>
  </table>
</div>

<!-- Mobile: stacked disclosures -->
<div class="space-y-3 md:hidden">
  {
    plans.map((plan) => (
      <details class="group rounded-card bg-surface-raised shadow-soft ring-1 ring-line open:ring-primary/40" open={plan.highlighted}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-5 [&::-webkit-details-marker]:hidden">
          <span>
            <span class="block text-lg font-bold">{plan.name[lang]}</span>
            <span class="text-sm text-fg-muted">
              <span dir="ltr" class="font-semibold text-fg">{formatPrice(plan, lang)}</span> {t('common.perMonth')} · {t('common.monthly')}
            </span>
          </span>
          <span class="inline-flex size-8 items-center justify-center rounded-full bg-stone-100 transition-transform group-open:rotate-180">
            <Icon name="chevron-down" size={18} />
          </span>
        </summary>
        <ul class="space-y-2.5 border-t border-line px-5 py-4 text-sm">
          {COMPARISON_KEYS.map((key) => (
            <li class:list={['flex items-center gap-2.5', !plan.comparison[key] && 'text-fg-muted']}>
              {plan.comparison[key] ? (
                <span class="inline-flex size-5 items-center justify-center rounded-full bg-primary text-on-primary">
                  <Icon name="check" size={11} strokeWidth={3} />
                </span>
              ) : (
                <span class="inline-flex size-5 items-center justify-center text-stone-500">
                  <Icon name="x" size={14} />
                </span>
              )}
              <span>
                {t(`pricingPage.comparison.${key}`)}
                <span class="sr-only"> — {plan.comparison[key] ? t('common.included') : t('common.notIncluded')}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="px-5 pb-5">
          <a href={routes.checkout(lang, plan.id)} class={buttonClass(plan.highlighted ? 'primary' : 'secondary', 'md', 'w-full')}>
            {t('common.subscribe')}
            <span class="sr-only">— {plan.name[lang]}</span>
          </a>
        </div>
      </details>
    ))
  }
</div>
