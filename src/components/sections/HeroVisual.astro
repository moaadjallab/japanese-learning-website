---
/**
 * Original decorative hero illustration (inline SVG): vermilion sun, a torii-inspired gate
 * (one of only two uses on the site), distant mountains and sakura petals, plus a small
 * "word of the day" card. Purely decorative except the card text.
 */
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const petals = [
  { x: 92, y: 96, r: -20, s: 1 },
  { x: 404, y: 72, r: 35, s: 0.8 },
  { x: 438, y: 248, r: 10, s: 1.1 },
  { x: 60, y: 300, r: 60, s: 0.7 },
  { x: 350, y: 362, r: -40, s: 0.9 },
];
---

<div class="relative mx-auto aspect-[5/4.4] w-full max-w-[34rem]">
  <svg
    viewBox="0 0 500 440"
    class="absolute inset-0 h-full w-full"
    role="img"
    aria-label={t('home.hero.visualLabel')}
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="hero-sun" cx="50%" cy="45%" r="55%">
        <stop offset="0%" stop-color="#D9433C"></stop>
        <stop offset="100%" stop-color="#B92A24"></stop>
      </radialGradient>
      <linearGradient id="hero-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FAF8F5" stop-opacity="0"></stop>
        <stop offset="100%" stop-color="#FAF8F5" stop-opacity="1"></stop>
      </linearGradient>
      <path id="hero-petal" d="M0 0c-6-6-7-15-2-20l2 3 2-3c5 5 4 14-2 20z"></path>
    </defs>

    <!-- Soft card backdrop -->
    <rect x="20" y="20" width="460" height="400" rx="36" fill="#F3D6DC" fill-opacity="0.45"></rect>
    <!-- Sun -->
    <circle cx="300" cy="170" r="104" fill="url(#hero-sun)"></circle>
    <!-- Mountains -->
    <path d="M20 330 L140 238 L210 286 L300 214 L420 316 L480 286 V420 H20 Z" fill="#E7DFD4"></path>
    <path d="M20 360 L120 300 L200 338 L290 288 L400 352 L480 330 V420 H20 Z" fill="#D9CFC1"></path>
    <!-- Torii-inspired gate (abstract) -->
    <g fill="#1B1B1F">
      <path d="M118 150 Q250 128 382 150 L386 166 Q250 148 114 166 Z"></path>
      <rect x="132" y="176" width="236" height="11" rx="2"></rect>
      <rect x="160" y="160" width="14" height="230" rx="3"></rect>
      <rect x="326" y="160" width="14" height="230" rx="3"></rect>
      <rect x="244" y="160" width="12" height="27"></rect>
    </g>
    <rect x="20" y="370" width="460" height="50" fill="url(#hero-fade)"></rect>
    <!-- Sakura petals -->
    <g fill="#E8A6B4">
      {petals.map((p) => (
        <use href="#hero-petal" transform={`translate(${p.x} ${p.y}) rotate(${p.r}) scale(${p.s})`} />
      ))}
    </g>
  </svg>

  <!-- Word-of-the-day card (real content, translated) -->
  <div class="absolute bottom-[6%] start-0 w-56 rounded-2xl bg-surface-raised/95 p-4 shadow-lift ring-1 ring-line backdrop-blur sm:start-[-4%]">
    <p class="text-xs font-semibold text-primary">{t('home.hero.sampleWord')}</p>
    <p class="mt-1 flex items-baseline gap-2">
      <span lang="ja" class="font-jp text-3xl text-fg">
        学ぶ
      </span>
      <span lang="ja" class="text-sm text-fg-muted">
        まなぶ
      </span>
    </p>
    <p class="mt-1 text-sm text-fg-muted">
      <span lang="ja-Latn" class="italic">
        manabu
      </span>{' '}
      — {t('home.hero.sampleMeaning')}
    </p>
  </div>

  <!-- Vertical Japanese accent -->
  <p
    lang="ja"
    aria-hidden="true"
    class="font-jp absolute end-[2%] top-[8%] text-lg tracking-[0.5em] text-ink/70 [writing-mode:vertical-rl]"
  >
    日本語を学ぶ
  </p>
</div>
