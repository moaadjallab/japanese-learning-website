---
/** Home SECTION 8 — FAQ preview (the 9 questions from the SPEC) + "View All FAQs". */
import Section from '@/components/ui/Section.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/icons/Icon.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { getHomeFaqs } from '@/lib/repositories/faqs';
import { routes } from '@/lib/routes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const faqs = await getHomeFaqs();
const items = faqs.map((faq) => ({
  id: `home-faq-${faq.id}`,
  title: (faq.homeQuestion ?? faq.question)[lang],
  content: faq.answer[lang],
}));
---

<Section id="faq" eyebrow={t('home.faq.eyebrow')} title={t('home.faq.title')} subtitle={t('home.faq.subtitle')} size="narrow">
  <Accordion items={items} name="home-faq" />
  <div class="mt-10 text-center">
    <Button href={routes.faq(lang)} variant="secondary" size="lg">
      {t('common.viewAllFaqs')}
      <Icon name="arrow-right" size={18} />
    </Button>
  </div>
</Section>
