---
/**
 * Home SECTION 3 — Explore Our Courses. Every visible course card (SPEC: 14 by default; admin-created courses included), plus quick filters by
 * level and category that open the full catalog with the filter applied.
 * Mobile: horizontal scroll-snap row (direction-aware, works in RTL); md+: grid.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/icons/Icon.astro';
import CourseCard from './CourseCard.astro';
import { getDictionary, useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { CATEGORY_IDS, LEVEL_IDS } from '@/lib/domain/types';
import { getCourseCards } from '@/lib/repositories/courses';
import { getDb } from '@/lib/auth/server';
import { routes } from '@/lib/routes';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDictionary(lang);
const courses = await getCourseCards(lang, getDb(Astro.locals));
const chip =
  'inline-flex items-center rounded-full bg-surface-raised px-3.5 py-1.5 text-sm font-medium text-fg ring-1 ring-line transition-colors hover:bg-sakura-soft hover:ring-sakura';
---

<Section
  id="courses"
  eyebrow={dict.home.courses.eyebrow}
  title={dict.home.courses.title}
  subtitle={dict.home.courses.subtitle}
  tone="sunken"
  size="wide"
  pattern
>
  <div class="mb-10 grid gap-5 lg:grid-cols-2">
    <nav aria-labelledby="browse-level">
      <h3 id="browse-level" class="mb-3 text-sm font-semibold text-fg-muted">
        {dict.home.courses.byLevel}
      </h3>
      <ul class="flex flex-wrap gap-2">
        {LEVEL_IDS.map((level) => (
          <li>
            <a class={chip} href={routes.courses(lang, { level })}>
              {dict.levels[level]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-labelledby="browse-category">
      <h3 id="browse-category" class="mb-3 text-sm font-semibold text-fg-muted">
        {dict.home.courses.byCategory}
      </h3>
      <ul class="flex flex-wrap gap-2">
        {CATEGORY_IDS.map((category) => (
          <li>
            <a class={chip} href={routes.courses(lang, { category })}>
              {dict.categories[category]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <ul
    class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:grid md:snap-none md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0 xl:grid-cols-4"
    aria-label={dict.home.courses.title}
  >
    {courses.map((course) => (
      <li class="w-[78%] max-w-xs shrink-0 snap-start min-[480px]:w-[60%] md:w-auto md:max-w-none">
        <CourseCard lang={lang} course={course} />
      </li>
    ))}
  </ul>

  <div class="mt-10 text-center">
    <Button href={routes.courses(lang)} variant="secondary" size="lg">
      {t('common.viewAllCourses')}
      <Icon name="arrow-right" size={18} />
    </Button>
  </div>
</Section>
