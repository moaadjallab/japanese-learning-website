---
/**
 * Course card: image, title, short description, level, category, "View Course".
 * The whole card is clickable via a stretched link; markup mirrors CourseCard.tsx.
 */
import Icon from '@/components/icons/Icon.astro';
import { badgeClass } from '@/components/ui/styles';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
import type { CourseCardData } from '@/lib/domain/types';

interface Props {
  lang: Locale;
  course: CourseCardData;
  headingLevel?: 'h2' | 'h3';
  class?: string;
  eager?: boolean;
}
const { lang, course, headingLevel: Heading = 'h3', class: className = '', eager = false } = Astro.props;
const t = useTranslations(lang);
---

<article
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-card bg-surface-raised shadow-soft ring-1 ring-line transition-[box-shadow,transform] duration-300 ease-out-soft focus-within:shadow-lift hover:-translate-y-0.5 hover:shadow-lift',
    className,
  ]}
>
  <div class="aspect-[16/10] overflow-hidden bg-stone-100">
    <img
      src={course.image}
      alt=""
      width="640"
      height="400"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-1.5">
      <span class={badgeClass('accent')}><span class="sr-only">{t('courseDetail.level')}: </span>{course.levelLabel}</span>
      <span class={badgeClass('neutral')}><span class="sr-only">{t('courseDetail.category')}: </span>{course.categoryLabel}</span>
    </div>
    <Heading class="mt-3 text-lg font-semibold">
      <a href={course.href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
        {course.title}
      </a>
    </Heading>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-fg-muted">{course.description}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary" aria-hidden="true">
      {t('common.viewCourse')}
      <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5" />
    </span>
  </div>
  <span class="pointer-events-none absolute inset-0 rounded-card ring-2 ring-primary opacity-0 group-focus-within:opacity-100" aria-hidden="true"></span>
</article>
