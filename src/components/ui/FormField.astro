---
/**
 * Label + control + hint + error, wired with for/id and aria-describedby.
 * Pass the control in the default slot and give it `id={id}` and
 * `aria-describedby={describedBy(id, { hint, error })}`.
 */
import Icon from '@/components/icons/Icon.astro';
import { errorClass, hintClass, labelClass } from './styles';

interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string;
  required?: boolean;
  class?: string;
}
const { id, label, hint, error, required = false, class: className = '' } = Astro.props;
---

<div class:list={['space-y-2', className]}>
  <label for={id} class={labelClass}>
    {label}
    {required && (
      <span aria-hidden="true" class="ms-0.5 text-primary">
        *
      </span>
    )}
  </label>
  <slot />
  {hint && (
    <p id={`${id}-hint`} class={hintClass}>
      {hint}
    </p>
  )}
  <p id={`${id}-error`} class={errorClass} hidden={!error}>
    <Icon name="alert" size={16} class="mt-0.5" />
    <span>{error}</span>
  </p>
</div>
