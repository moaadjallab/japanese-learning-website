---
/** Page-width wrapper with responsive gutters (16px on phones). */
interface Props {
  size?: 'narrow' | 'default' | 'wide';
  class?: string;
}
const { size = 'default', class: className = '' } = Astro.props;
const widths = { narrow: 'max-w-3xl', default: 'max-w-6xl', wide: 'max-w-7xl' };
---

<div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', widths[size], className]}>
  <slot />
</div>
