---
/** Surface card. `as` lets cards be <article>/<li> for correct semantics. */
import { cardClass } from './styles';

interface Props {
  as?: 'div' | 'article' | 'li' | 'section' | 'aside';
  class?: string;
  interactive?: boolean;
  padding?: 'none' | 'md' | 'lg';
}
const { as: Tag = 'div', class: className = '', interactive = false, padding = 'md' } = Astro.props;
const paddings = { none: '', md: 'p-6', lg: 'p-6 sm:p-8' };
---

<Tag
  class:list={[
    cardClass,
    paddings[padding],
    interactive &&
      'transition-[box-shadow,transform] duration-300 ease-out-soft hover:-translate-y-0.5 hover:shadow-lift focus-within:shadow-lift',
    className,
  ]}
>
  <slot />
</Tag>
