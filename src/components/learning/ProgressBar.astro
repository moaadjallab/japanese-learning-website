---
/** Accessible progress bar (role="progressbar"). */
interface Props {
  value: number;
  label: string;
  class?: string;
}
const { value, label, class: className = '' } = Astro.props;
const clamped = Math.max(0, Math.min(100, Math.round(value)));
---

<div
  role="progressbar"
  aria-label={label}
  aria-valuenow={clamped}
  aria-valuemin="0"
  aria-valuemax="100"
  class:list={['h-2 w-full overflow-hidden rounded-full bg-stone-100', className]}
>
  <div class="h-full rounded-full bg-primary transition-[width]" style={`width:${clamped}%`}></div>
</div>
