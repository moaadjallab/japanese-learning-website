---
/** Sub-navigation of the administration area (students & classes / courses). */
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { routes } from '@/lib/routes';

interface Props {
  lang: Locale;
  active: 'people' | 'courses';
}
const { lang, active } = Astro.props;
const t = useTranslations(lang);
const items = [
  { id: 'people', href: routes.admin(lang), label: t('admin.nav.people') },
  { id: 'courses', href: routes.adminCourses(lang), label: t('admin.nav.courses') },
] as const;
---

<nav aria-label={t('admin.nav.label')} class="mb-8 flex flex-wrap gap-2">
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.id === active ? 'page' : undefined}
      class:list={[
        'rounded-full px-4 py-2 text-sm font-semibold ring-1 transition-colors',
        item.id === active
          ? 'bg-primary text-on-primary ring-primary'
          : 'bg-surface-raised ring-line hover:bg-stone-50',
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>
