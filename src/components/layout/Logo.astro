---
/** Wordmark: logo mark + brand name (from src/config/site.ts) + small 日本語 accent. */
import LogoMark from './LogoMark.astro';
import { site } from '@/config/site';
import { routes } from '@/lib/routes';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
  tone?: 'default' | 'inverse';
  class?: string;
}
const { lang, tone = 'default', class: className = '' } = Astro.props;
---

<a
  href={routes.home(lang)}
  class:list={['group inline-flex items-center gap-2.5 rounded-lg', className]}
>
  <LogoMark size={34} class="transition-transform duration-500 group-hover:rotate-[72deg]" />
  <span class="flex flex-col leading-none">
    <span class:list={['text-[1.05rem] font-bold tracking-tight', tone === 'inverse' ? 'text-washi' : 'text-fg']}>
      {site.name[lang]}
    </span>
    <span
      lang="ja"
      aria-hidden="true"
      class:list={['font-jp mt-1 text-[0.7rem] tracking-[0.35em]', tone === 'inverse' ? 'text-sakura' : 'text-primary']}
    >
      {site.japaneseAccent}
    </span>
  </span>
</a>
