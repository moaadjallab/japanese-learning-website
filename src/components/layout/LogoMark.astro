---
/**
 * PLACEHOLDER logo mark (original): a vermilion sun with a five-petal sakura cut-out.
 * Replace with the final logo; keep the same props so every usage keeps working.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = '' } = Astro.props;
const petals = [0, 72, 144, 216, 288];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 40"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <circle cx="20" cy="20" r="19" fill="#C8312B"></circle>
  <g fill="#FAF8F5">
    {petals.map((deg) => (
      <path
        transform={`rotate(${deg} 20 20)`}
        d="M20 19.2c-2.9-2.6-3.8-6.2-2.2-8.9l1.4 1.3.8-2 .8 2 1.4-1.3c1.6 2.7.7 6.3-2.2 8.9z"
      />
    ))}
  </g>
  <circle cx="20" cy="20" r="1.6" fill="#C8312B"></circle>
</svg>
