    "title": { "en": "The three Japanese writing systems", "ar": "أنظمة الكتابة اليابانية الثلاثة" },
    "summary": {
      "en": "Japanese mixes three scripts: hiragana for grammar and native words, katakana for foreign words, and kanji for meaning. In this course you master the first two.",
      "ar": "تجمع اليابانية بين ثلاثة أنظمة كتابة: الهيراغانا للقواعد والكلمات الأصلية، والكاتاكانا للكلمات الأجنبية، والكانجي للمعاني. في هذه الدورة ستتقن النظامين الأولين."
    },
    "items": [
      {
        "ja": "ひらがな",
        "romaji": "hiragana",
        "meaning": { "en": "hiragana (phonetic script)", "ar": "الهيراغانا (كتابة صوتية)" }
      },
      {
        "ja": "カタカナ",
        "romaji": "katakana",
        "meaning": {
          "en": "katakana (phonetic script for foreign words)",
          "ar": "الكاتاكانا (كتابة صوتية للكلمات الأجنبية)"
        }
      },
      {
        "ja": "漢字",
        "romaji": "kanji",
        "meaning": { "en": "kanji (Chinese characters)", "ar": "الكانجي (الحروف الصينية)" }
      }
    ]
  },
