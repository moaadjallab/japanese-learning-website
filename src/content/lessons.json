        "ja": "それはほんです。",
        "romaji": "Sore wa hon desu.",
        "meaning": { "en": "That is a book.", "ar": "ذلك كتاب." }
      },
      {
        "ja": "これはペンですか。",
        "romaji": "Kore wa pen desu ka.",
        "meaning": { "en": "Is this a pen?", "ar": "هل هذا قلم؟" }
