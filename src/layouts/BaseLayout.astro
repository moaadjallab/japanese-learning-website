---
/**
 * Root layout for every localized page: <html lang dir>, SEO head, fonts,
 * skip link, header, main landmark and footer.
 */
import '@/styles/fonts.css';
import '@/styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import plexArabic from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import plexArabicBold from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';
import Seo from '@/components/layout/Seo.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/client';
import { useTranslations } from '@/i18n';
import { LOCALE_META, type Locale } from '@/i18n/config';
import type { ComponentProps } from 'astro/types';

type SeoProps = ComponentProps<typeof Seo>;
interface Props extends Omit<SeoProps, 'lang'> {
  lang: Locale;
  /** Minimal chrome (auth & checkout): header/footer still render, but no extra CTAs. */
  bodyClass?: string;
}
const { lang, bodyClass = '', ...seo } = Astro.props;
const t = useTranslations(lang);
const meta = LOCALE_META[lang];
// Preload only the critical text fonts for this locale: Inter is one variable file for all
// weights; Arabic needs regular (body) + bold (headings, usually the LCP element).
const criticalFonts = lang === 'ar' ? [plexArabic, plexArabicBold] : [interLatin];
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF8F5" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    {criticalFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo lang={lang} {...seo} />
    {
      /* Analytics hook: Cloudflare Web Analytics, only when a token is configured. */
      PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
          defer
          is:inline
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body class:list={['flex min-h-dvh flex-col bg-surface text-fg', bodyClass]}>
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-ink px-5 py-3 font-semibold text-washi focus:not-sr-only focus:fixed focus:start-4 focus:top-3"
    >
      {t('common.skipToContent')}
    </a>
    <Header lang={lang} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
