---
/**
 * About: Our Story · Our Mission (SPEC statement) · Our Teaching Approach · Why Learn Japanese With Us.
 * No invented personal information about teachers.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import Features from '@/components/sections/Features.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Icon from '@/components/icons/Icon.astro';
import type { IconName } from '@/components/icons/paths';
import { site } from '@/config/site';
import { getDictionary, interpolate, localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';
import { ph } from '@/lib/placeholder';
import { breadcrumbLd, organizationLd } from '@/lib/seo/jsonld';
import { routes } from '@/lib/routes';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const dict = getDictionary(lang);
const brand = site.name[lang];
const siteUrl = Astro.site ?? Astro.url.origin;
const approachIcons: IconName[] = ['route', 'globe', 'pencil', 'video'];
---

<BaseLayout
  lang={lang}
  title={t('aboutPage.meta.title')}
  description={t('aboutPage.meta.description')}
  jsonLd={[
    organizationLd(lang, siteUrl),
    breadcrumbLd(
      [
        { name: t('nav.home'), path: routes.home(lang) },
        { name: t('nav.about'), path: routes.about(lang) },
      ],
      siteUrl,
    ),
  ]}
>
  <PageHeader
    lang={lang}
    eyebrow={t('aboutPage.eyebrow')}
    title={t('aboutPage.title', { brand })}
    subtitle={t('aboutPage.subtitle')}
    accent="学ぶ"
  />

  <!-- Our Story -->
  <section aria-labelledby="story-title" class="py-14 sm:py-20">
    <Container class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <p lang="ja" aria-hidden="true" class="font-jp text-5xl text-primary">物語</p>
        <h2 id="story-title" class="mt-3 text-3xl font-bold sm:text-4xl">{t('aboutPage.story.title')}</h2>
      </div>
      <div class="space-y-5 text-lg text-fg-muted">
        {dict.aboutPage.story.paragraphs.map((p) => <p>{interpolate(p, { brand })}</p>)}
      </div>
    </Container>
  </section>

  <!-- Our Mission -->
  <section aria-labelledby="mission-title" class="px-4 sm:px-6 lg:px-8">
    <div class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-sakura-soft px-6 py-14 text-center ring-1 ring-sakura sm:px-16 sm:py-20">
      <div class="pattern-seigaiha pointer-events-none absolute inset-0 -z-10 opacity-[0.05]" aria-hidden="true"></div>
      <h2 id="mission-title" class="text-sm font-semibold tracking-wide text-primary">{t('aboutPage.mission.title')}</h2>
      <blockquote class="mx-auto mt-5 max-w-3xl text-2xl leading-snug font-semibold text-fg sm:text-3xl">
        <p>“{t('aboutPage.mission.statement')}”</p>
      </blockquote>
    </div>
  </section>

  <!-- Our Teaching Approach -->
  <section aria-labelledby="approach-title" class="py-14 sm:py-20">
    <Container>
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 id="approach-title" class="text-3xl font-bold sm:text-4xl">{t('aboutPage.approach.title')}</h2>
        <p class="mt-4 text-lg text-fg-muted">{t('aboutPage.approach.intro')}</p>
      </div>
      <ol class="grid gap-5 sm:grid-cols-2">
        {
          dict.aboutPage.approach.items.map((item, i) => (
            <li class="reveal flex gap-5 rounded-card bg-surface-raised p-6 shadow-soft ring-1 ring-line">
              <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-ink text-washi">
                <Icon name={approachIcons[i] ?? 'sparkle'} size={22} />
              </span>
              <div>
                <h3 class="text-lg font-semibold">{item.title}</h3>
                <p class="mt-1.5 text-fg-muted">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <!-- Why Learn Japanese With Us (shared feature cards) -->
  <Features lang={lang} id="why-us" title={t('aboutPage.why.title')} headingTone="sunken" />

  <!-- Teachers (placeholder; multi-teacher ready) -->
  <section aria-labelledby="teachers-title" class="py-14 sm:py-20">
    <Container size="narrow" class="text-center">
      <h2 id="teachers-title" class="text-3xl font-bold">{t('aboutPage.teacher.title')}</h2>
      <p class="mt-4 text-lg text-fg-muted" {...ph('teacher profiles')}>{t('aboutPage.teacher.body')}</p>
    </Container>
  </section>

  <FinalCta lang={lang} />
</BaseLayout>
