---
/**
 * Hidden component styleguide at /en/_styleguide (and /ar/_styleguide for RTL checks).
 * DEV ONLY: getStaticPaths returns nothing in production builds, so the page is never
 * deployed. It is also noindex and excluded from the sitemap.
 * (Section labels here are developer-facing and intentionally not translated.)
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Accordion from '@/components/ui/Accordion.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import FormField from '@/components/ui/FormField.astro';
import Input from '@/components/ui/Input.astro';
import Section from '@/components/ui/Section.astro';
import Select from '@/components/ui/Select.astro';
import Tabs from '@/components/ui/Tabs.astro';
import Textarea from '@/components/ui/Textarea.astro';
import Icon from '@/components/icons/Icon.astro';
import { ICON_PATHS, type IconName } from '@/components/icons/paths';
import { LOCALES, resolveLocale, useTranslations, getDictionary } from '@/i18n';
import { routes } from '@/lib/routes';

export function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return LOCALES.map((lang) => ({ params: { lang, styleguide: '_styleguide' } }));
}

const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const dict = getDictionary(lang);
const swatches = [
  ['washi', '#FAF8F5', 'bg-washi'],
  ['paper', '#FFFFFF', 'bg-paper'],
  ['ink', '#1B1B1F', 'bg-ink'],
  ['vermilion', '#C8312B', 'bg-vermilion'],
  ['vermilion-dark', '#A3241F', 'bg-vermilion-dark'],
  ['sakura', '#F3D6DC', 'bg-sakura'],
  ['sakura-soft', '#FBF0F2', 'bg-sakura-soft'],
  ['stone-100', '#EDE8E1', 'bg-stone-100'],
  ['stone-200', '#E2DCD2', 'bg-stone-200'],
  ['stone-600', '#5F5A52', 'bg-stone-600'],
] as const;
const icons = Object.keys(ICON_PATHS) as IconName[];
const sgTitle = 'font-mono text-xs font-semibold uppercase tracking-widest text-fg-muted mb-4';
---

<BaseLayout lang={lang} title="Styleguide" description="Internal component styleguide" noindex>
  <Section
    headingLevel="h1"
    title="Styleguide"
    subtitle="Dev-only overview of tokens and components."
    align="start"
  >
    <p class="mb-8 text-sm text-fg-muted">
      Other pages:{' '}
      <a class="text-primary underline" href={routes.checkoutSuccess(lang) + '?preview=1'}>
        success (preview)
      </a>
      ·{' '}
      <a class="text-primary underline" href="/en/does-not-exist/">
        404
      </a>
    </p>

    <h2 class={sgTitle}>Colors</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-5">
      {swatches.map(([name, hex, cls]) => (
        <div class="overflow-hidden rounded-xl ring-1 ring-line">
          <div class:list={['h-16', cls]} />
          <div class="bg-surface-raised p-2 text-xs">
            <p class="font-semibold">{name}</p>
            <p class="font-mono text-fg-muted">{hex}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Typography</h2>
    <div class="space-y-3">
      <p class="text-5xl font-bold">Display 5xl — 学ぶ</p>
      <p class="text-3xl font-bold">Heading 3xl</p>
      <p class="text-xl font-semibold">Heading xl</p>
      <p class="text-base">Body — The quick brown fox. نص عربي للتجربة.</p>
      <p class="text-sm text-fg-muted">Muted small text</p>
      <p lang="ja" class="font-jp text-4xl">
        日本語 · ひらがな · カタカナ · 漢字
      </p>
      <p lang="ja" class="text-xl">
        日本語を勉強しています。{' '}
        <span lang="en" class="text-fg-muted">
          (Nihongo o benkyō shite imasu.)
        </span>
      </p>
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Buttons</h2>
    <div class="flex flex-wrap items-center gap-3">
      <Button>{t('common.startLearning')}</Button>
      <Button variant="secondary">{t('common.viewPlans')}</Button>
      <Button variant="ghost">Ghost</Button>
      <Button variant="link" href="#">
        Link
      </Button>
      <Button size="sm">Small</Button>
      <Button size="lg">
        Large <Icon name="arrow-right" size={18} />
      </Button>
      <Button disabled>Disabled</Button>
      <div class="rounded-xl bg-ink p-3">
        <Button variant="inverse">Inverse</Button>
      </div>
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Badges</h2>
    <div class="flex flex-wrap gap-2">
      <Badge>Neutral</Badge>
      <Badge tone="primary">{t('common.mostPopular')}</Badge>
      <Badge tone="accent">N5</Badge>
      <Badge tone="ink">JLPT</Badge>
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Cards</h2>
    <div class="grid gap-4 sm:grid-cols-3">
      <Card>
        <p class="font-semibold">Card</p>
        <p class="mt-2 text-sm text-fg-muted">Default padding.</p>
      </Card>
      <Card interactive>
        <p class="font-semibold">Interactive card</p>
        <p class="mt-2 text-sm text-fg-muted">Hover me.</p>
      </Card>
      <Card padding="lg" class="bg-sakura-soft">
        <p class="font-semibold">Tinted card</p>
      </Card>
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Icons</h2>
    <div class="flex flex-wrap gap-3">
      {icons.map((name) => (
        <span
          class="inline-flex flex-col items-center gap-1 rounded-lg bg-surface-raised p-3 text-[10px] ring-1 ring-line"
          title={name}
        >
          <Icon name={name} size={22} />
          {name}
        </span>
      ))}
    </div>

    <h2 class:list={[sgTitle, 'mt-12']}>Form controls</h2>
    <form class="grid max-w-xl gap-5" novalidate>
      <FormField id="sg-name" label={dict.contactPage.form.name} required>
        <Input id="sg-name" name="name" autocomplete="name" required />
      </FormField>
      <FormField id="sg-email" label={dict.contactPage.form.email} error={dict.validation.email} required>
        <Input
          id="sg-email"
          name="email"
          type="email"
          aria-invalid="true"
          aria-describedby="sg-email-error"
          value="not-an-email"
        />
      </FormField>
      <FormField id="sg-level" label={dict.auth.register.japaneseLevel} hint="Hint text">
        <Select
          id="sg-level"
          name="level"
          aria-describedby="sg-level-hint"
          placeholder={dict.auth.register.chooseLevel}
          options={Object.entries(dict.levels).map(([value, label]) => ({ value, label }))}
        />
      </FormField>
      <FormField id="sg-message" label={dict.contactPage.form.message}>
        <Textarea id="sg-message" name="message" />
      </FormField>
    </form>

    <h2 class:list={[sgTitle, 'mt-12']}>Accordion</h2>
    <Accordion
      name="sg"
      openFirst
      items={[
        { id: 'sg-a1', title: 'First question', content: 'Answer one.\n\nSecond paragraph.' },
        { id: 'sg-a2', title: 'Second question', content: 'Answer two.' },
      ]}
    />

    <h2 class:list={[sgTitle, 'mt-12']}>Tabs</h2>
    <Tabs id="sg-tabs" label="Example tabs" tabs={['Hiragana', 'Katakana', 'Kanji']}>
      <p slot="panel-0" lang="ja" class="font-jp text-3xl">
        あ い う え お
      </p>
      <p slot="panel-1" lang="ja" class="font-jp text-3xl">
        ア イ ウ エ オ
      </p>
      <p slot="panel-2" lang="ja" class="font-jp text-3xl">
        山 川 日 月 人
      </p>
    </Tabs>
  </Section>
</BaseLayout>
