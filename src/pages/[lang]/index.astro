---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('home.meta.title')} description={t('home.meta.description')}>
  <h1 class="p-10 text-4xl font-bold">{t('home.hero.title')}</h1>
</BaseLayout>
