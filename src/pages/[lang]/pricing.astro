---
/** Pricing: 3 monthly plans, detailed comparison table, subscription FAQs, CTA. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import Accordion from '@/components/ui/Accordion.astro';
import PricingCards from '@/components/sections/PricingCards.astro';
import PricingTable from '@/components/sections/PricingTable.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Icon from '@/components/icons/Icon.astro';
import { localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';
import { getFaqs } from '@/lib/repositories/faqs';
import { ph } from '@/lib/placeholder';
import { breadcrumbLd } from '@/lib/seo/jsonld';
import { routes } from '@/lib/routes';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const siteUrl = Astro.site ?? Astro.url.origin;
const faqs = (await getFaqs())
  .filter((f) => f.category === 'subscriptions' || f.category === 'payments')
  .sort((a, b) => a.category.localeCompare(b.category) * -1 || a.order - b.order)
  .map((f) => ({ id: `pricing-faq-${f.id}`, title: f.question[lang], content: f.answer[lang] }));
---

<BaseLayout
  lang={lang}
  title={t('pricingPage.meta.title')}
  description={t('pricingPage.meta.description')}
  jsonLd={[
    breadcrumbLd(
      [
        { name: t('nav.home'), path: routes.home(lang) },
        { name: t('nav.pricing'), path: routes.pricing(lang) },
      ],
      siteUrl,
    ),
  ]}
>
  <PageHeader
    lang={lang}
    eyebrow={t('pricingPage.eyebrow')}
    title={t('pricingPage.title')}
    subtitle={t('pricingPage.subtitle')}
    accent="料金"
  />

  <section id="plans" aria-label={t('pricingPage.title')} class="py-14 sm:py-20">
    <Container>
      <PricingCards lang={lang} headingLevel="h2" />
      <p
        class="mt-10 flex items-center justify-center gap-2 text-center text-sm text-fg-muted"
        {...ph('final prices')}
      >
        <Icon name="info" size={16} />
        {t('pricingPage.billingNote')}
      </p>
    </Container>
  </section>

  <section
    id="compare"
    aria-labelledby="compare-title"
    class="border-y border-line bg-surface-sunken py-14 sm:py-20"
  >
    <Container>
      <div class="mb-10 text-center">
        <h2 id="compare-title" class="text-3xl font-bold sm:text-4xl">
          {t('pricingPage.compareTitle')}
        </h2>
        <p class="mt-3 text-lg text-fg-muted">{t('pricingPage.compareSubtitle')}</p>
      </div>
      <PricingTable lang={lang} />
    </Container>
  </section>

  <section aria-labelledby="pricing-faq-title" class="py-14 sm:py-20">
    <Container size="narrow">
      <h2 id="pricing-faq-title" class="text-center text-3xl font-bold">
        {t('pricingPage.questionsTitle')}
      </h2>
      <p class="mt-3 text-center text-lg text-fg-muted">{t('pricingPage.questionsBody')}</p>
      <Accordion items={faqs} name="pricing-faq" class="mt-10" />
      <p class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
        <a href={routes.faq(lang)} class="text-primary underline-offset-4 hover:underline">
          {t('common.viewAllFaqs')}
        </a>
        <a href={routes.contact(lang)} class="text-primary underline-offset-4 hover:underline">
          {t('common.contactUs')}
        </a>
      </p>
    </Container>
  </section>

  <FinalCta lang={lang} cta={t('common.subscribeNow')} ctaHref="#plans" />
</BaseLayout>
