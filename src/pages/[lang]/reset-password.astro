---
/** Password reset link target. The island reads ?token= in the browser (page stays static). */
import AuthLayout from '@/layouts/AuthLayout.astro';
import { ResetPasswordForm } from '@/components/islands/AuthForms';
import { getDictionary, localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';
import { authCommonLabels } from '@/lib/auth/labels';
import { routes } from '@/lib/routes';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const dict = getDictionary(lang);
const r = dict.auth.reset;
---

<AuthLayout
  lang={lang}
  metaTitle={t('auth.reset.meta.title')}
  metaDescription={t('auth.reset.meta.description')}
  title={r.title}
  subtitle={r.subtitle}
>
  <ResetPasswordForm
    client:load
    labels={{
      password: r.password,
      passwordHint: dict.auth.register.passwordHint,
      confirmPassword: r.confirmPassword,
      submit: r.submit,
      success: r.success,
      invalidLink: r.invalidLink,
      requestNew: r.requestNew,
      requestNewHref: routes.forgotPassword(lang),
      login: dict.auth.login.submit,
      loginHref: routes.login(lang),
    }}
    common={authCommonLabels(lang)}
    validation={dict.validation}
  />
</AuthLayout>
