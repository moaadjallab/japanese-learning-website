---
/** Contact page: form (React island → POST /api/contact) + WhatsApp / Email / Instagram. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/sections/PageHeader.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/icons/Icon.astro';
import ContactForm from '@/components/islands/ContactForm';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { site } from '@/config/site';
import { getDictionary, localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';
import { escapeHtml } from '@/lib/email';
import { ph } from '@/lib/placeholder';
import { routes } from '@/lib/routes';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const dict = getDictionary(lang);

const privacyLink = `<a class="font-semibold text-primary underline-offset-4 hover:underline" href="${routes.legal(lang, 'privacy')}">${escapeHtml(t('legalLinks.privacy'))}</a>`;
const privacyNoteHtml = escapeHtml(dict.contactPage.form.privacyNote).replace('{privacy}', privacyLink);

const channels = [
  {
    icon: 'chat',
    title: t('contactPage.channels.whatsapp'),
    body: t('contactPage.channels.whatsappBody'),
    value: site.contact.whatsappDisplay,
    href: `https://wa.me/${site.contact.whatsapp}`,
    external: true,
  },
  {
    icon: 'mail',
    title: t('contactPage.channels.email'),
    body: t('contactPage.channels.emailBody'),
    value: site.contact.email,
    href: `mailto:${site.contact.email}`,
    external: false,
  },
  {
    icon: 'camera',
    title: t('contactPage.channels.instagram'),
    body: t('contactPage.channels.instagramBody'),
    value: `@${site.contact.instagramHandle}`,
    href: site.contact.instagramUrl,
    external: true,
  },
] as const;
---

<BaseLayout lang={lang} title={t('contactPage.meta.title')} description={t('contactPage.meta.description')}>
  <PageHeader
    lang={lang}
    eyebrow={t('contactPage.eyebrow')}
    title={t('contactPage.title')}
    subtitle={t('contactPage.subtitle')}
    accent="連絡"
  />

  <Container class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.5fr_1fr] lg:gap-12">
    <section
      aria-labelledby="form-title"
      class="rounded-card bg-surface-raised p-6 shadow-soft ring-1 ring-line sm:p-8"
    >
      <h2 id="form-title" class="mb-6 text-2xl font-bold">
        {t('contactPage.form.title')}
      </h2>
      <ContactForm
        client:load
        locale={lang}
        labels={{ ...dict.contactPage.form, formErrors: dict.validation.formErrors }}
        validation={dict.validation}
        turnstileSiteKey={PUBLIC_TURNSTILE_SITE_KEY}
        privacyNoteHtml={privacyNoteHtml}
      />
    </section>

    <aside aria-labelledby="channels-title">
      <h2 id="channels-title" class="text-xl font-bold">
        {t('contactPage.channels.title')}
      </h2>
      <ul class="mt-5 space-y-3">
        {channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="group flex items-center gap-4 rounded-card bg-surface-raised p-5 ring-1 ring-line transition-shadow hover:shadow-lift"
              {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-sakura-soft text-primary ring-1 ring-sakura">
                <Icon name={channel.icon} size={22} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{channel.title}</span>
                <span class="block text-sm text-fg-muted">{channel.body}</span>
                <span
                  dir="ltr"
                  class="mt-1 block truncate text-start text-sm font-medium text-fg rtl:text-end"
                  {...ph('contact detail')}
                >
                  {channel.value}
                </span>
              </span>
              <Icon
                name={channel.external ? 'external' : 'arrow-right'}
                size={18}
                class="text-stone-500 group-hover:text-primary"
              />
              {channel.external && <span class="sr-only">{t('common.opensNewTab')}</span>}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </Container>
</BaseLayout>
