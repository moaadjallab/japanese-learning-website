---
/** Email verification link target (on demand): consumes the one-time token and shows the result. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/icons/Icon.astro';
import { buttonClass } from '@/components/ui/styles';
import { isLocale, useTranslations } from '@/i18n';
import { consumeOneTimeToken, getDb, markEmailVerified } from '@/lib/auth/server';
import { tokenSchema } from '@/lib/validation/schemas';
import { routes } from '@/lib/routes';

export const prerender = false;

if (!isLocale(Astro.params.lang)) return Astro.redirect(routes.home('en'));
const lang = Astro.params.lang;
const t = useTranslations(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');
// Never leak the token to third parties through the Referer header.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

let verified = false;
const db = getDb(Astro.locals);
const parsed = tokenSchema.safeParse({ token: Astro.url.searchParams.get('token') ?? '' });
if (db && parsed.success) {
  const userId = await consumeOneTimeToken(db, parsed.data.token, 'email_verification');
  if (userId) {
    await markEmailVerified(db, userId);
    verified = true;
  }
}
const signedIn = Boolean(Astro.locals.session);
---

<BaseLayout
  lang={lang}
  title={t('auth.verify.meta.title')}
  description={t('auth.verify.meta.description')}
  noindex
>
  <section class="py-20 sm:py-28" aria-labelledby="verify-title">
    <Container size="narrow" class="text-center">
      <span
        class:list={[
          'mx-auto inline-flex size-16 items-center justify-center rounded-full',
          verified ? 'bg-primary text-on-primary' : 'bg-stone-100 text-fg',
        ]}
      >
        <Icon name={verified ? 'check' : 'alert'} size={32} />
      </span>
      <h1 id="verify-title" class="mt-6 text-3xl font-bold">
        {verified ? t('auth.verify.successTitle') : t('auth.verify.failedTitle')}
      </h1>
      <p class="mt-3 text-lg text-fg-muted">
        {verified ? t('auth.verify.successBody') : t('auth.verify.failedBody')}
      </p>
      <a
        href={signedIn ? routes.account(lang) : routes.login(lang)}
        class={buttonClass('primary', 'lg', 'mt-8')}
      >
        {signedIn ? t('nav.account') : t('nav.login')}
      </a>
    </Container>
  </section>
</BaseLayout>
