---
/**
 * Payment success (on-demand). Only shown when the payment provider CONFIRMS an active
 * subscription for ?session_id=. V1 has no provider able to verify payments, so normal visitors
 * are redirected to Pricing. A design preview is available in development only: ?preview=1.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/icons/Icon.astro';
import { buttonClass } from '@/components/ui/styles';
import { isLocale, useTranslations } from '@/i18n';
import { getPaymentProvider } from '@/lib/payments';
import { routes } from '@/lib/routes';

export const prerender = false;

if (!isLocale(Astro.params.lang)) return Astro.redirect(routes.pricing('en'));
const lang = Astro.params.lang;
const t = useTranslations(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === '1';
let verified = false;
if (!isPreview) {
  const sessionId = Astro.url.searchParams.get('session_id');
  if (sessionId) {
    try {
      const info = await getPaymentProvider().getSubscriptionStatus(sessionId);
      verified = info.status === 'active' || info.status === 'trialing';
    } catch {
      verified = false;
    }
  }
  if (!verified) return Astro.redirect(routes.pricing(lang));
}
---

<BaseLayout lang={lang} title={t('success.meta.title')} description={t('success.meta.description')} noindex>
  {
    isPreview && (
      <p class="bg-ink px-4 py-2 text-center text-xs font-semibold text-washi" role="note">
        {t('success.previewNotice')}
      </p>
    )
  }
  <section class="relative isolate overflow-hidden py-20 sm:py-28" aria-labelledby="success-title">
    <div class="pattern-seigaiha pointer-events-none absolute inset-0 -z-10 opacity-[0.05]" aria-hidden="true"></div>
    <Container size="narrow" class="text-center">
      <span class="mx-auto inline-flex size-20 items-center justify-center rounded-full bg-primary text-on-primary shadow-lift">
        <Icon name="check" size={40} strokeWidth={2.5} />
      </span>
      <p lang="ja" aria-hidden="true" class="font-jp mt-8 text-xl tracking-[0.4em] text-primary">ようこそ</p>
      <h1 id="success-title" class="mt-3 text-3xl font-bold sm:text-5xl">{t('success.title')}</h1>
      <p class="mt-5 text-lg text-fg-muted">{t('success.body')}</p>
      <p class="mt-2 text-fg-muted">{t('success.nextSteps')}</p>
      <!-- V2: link to the student dashboard (routes.dashboard). V1 has no dashboard yet. -->
      <a href={routes.courses(lang)} class={buttonClass('primary', 'lg', 'mt-10')}>
        {t('success.cta')}
        <Icon name="arrow-right" size={18} />
      </a>
    </Container>
  </section>
</BaseLayout>
