---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { ForgotPasswordForm } from '@/components/islands/AuthForms';
import Icon from '@/components/icons/Icon.astro';
import { getDictionary, localeStaticPaths, resolveLocale, useTranslations } from '@/i18n';
import { authCommonLabels } from '@/lib/auth/labels';
import { routes } from '@/lib/routes';

export const getStaticPaths = localeStaticPaths;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
const dict = getDictionary(lang);
---

<AuthLayout
  lang={lang}
  metaTitle={t('auth.forgot.meta.title')}
  metaDescription={t('auth.forgot.meta.description')}
  title={t('auth.forgot.title')}
  subtitle={t('auth.forgot.subtitle')}
>
  <ForgotPasswordForm
    client:load
    labels={{ email: dict.auth.forgot.email, submit: dict.auth.forgot.submit }}
    common={authCommonLabels(lang)}
    validation={dict.validation}
  />
  <a href={routes.login(lang)} class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-fg-muted hover:text-fg">
    <Icon name="arrow-right" size={16} class="rotate-180" />
    {t('auth.forgot.backToLogin')}
  </a>
</AuthLayout>
