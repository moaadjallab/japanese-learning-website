---
/** Student space — a course: progress and the list of lessons. */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ProgressBar from '@/components/learning/ProgressBar.astro';
import Icon from '@/components/icons/Icon.astro';
import { buttonClass } from '@/components/ui/styles';
import { getDictionary, useTranslations } from '@/i18n';
import { canAccessCourse, nextLesson, progressPercent } from '@/lib/learning/access';
import { loadStudentContext } from '@/lib/learning/page';
import { getCompletedLessons } from '@/lib/learning/server';
import { getCourse } from '@/lib/repositories/courses';
import { getCourseLessons } from '@/lib/repositories/lessons';
import { routes } from '@/lib/routes';

export const prerender = false;

const ctx = await loadStudentContext(Astro);
if (ctx instanceof Response) return ctx;
const { lang, user, db, subscription } = ctx;
const t = useTranslations(lang);
const dict = getDictionary(lang);

const course = await getCourse(String(Astro.params.course), db);
if (!course) return Astro.redirect(routes.dashboardCourses(lang));
// Not in the plan → back to the course list (which explains how to unlock it).
if (!canAccessCourse(subscription?.plan ?? null, course.plans))
  return Astro.redirect(routes.dashboardCourses(lang));

const lessons = await getCourseLessons(course.slug, db);
const completed = await getCompletedLessons(db, user.id, course.slug);
const done = lessons.filter((l) => completed.has(l.id)).length;
const percent = progressPercent(done, lessons.length);
const resume = nextLesson(lessons, completed);
---

<DashboardLayout
  lang={lang}
  user={user}
  title={course.title[lang]}
  heading={course.title[lang]}
  subtitle={course.description[lang]}
  active="courses"
>
  {lessons.length === 0 ? (
    <p class="rounded-card bg-sakura-soft p-6 text-fg ring-1 ring-sakura">
      {t('dashboard.courses.noLessons')}
    </p>
  ) : (
    <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
      <section aria-labelledby="lessons-title">
        <h2 id="lessons-title" class="mb-4 text-xl font-bold">
          {t('dashboard.courses.lessonList')}
        </h2>
        <ol class="divide-y divide-line overflow-hidden rounded-card bg-surface-raised ring-1 ring-line">
          {lessons.map((lesson, i) => {
            const isDone = completed.has(lesson.id);
            return (
              <li>
                <a
                  href={routes.dashboardLesson(lang, course.slug, lesson.slug)}
                  class="flex items-center gap-4 p-4 transition-colors hover:bg-washi sm:p-5"
                >
                  <span
                    class:list={[
                      'inline-flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold',
                      isDone ? 'bg-primary text-on-primary' : 'bg-stone-100 text-fg',
                    ]}
                  >
                    {isDone ? (
                      <Icon name="check" size={16} strokeWidth={3} label={t('dashboard.lesson.completed')} />
                    ) : (
                      i + 1
                    )}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold">{lesson.title[lang]}</span>
                    <span class="block text-sm text-fg-muted">
                      {dict.dashboard.lesson.types[lesson.type]} ·{' '}
                      {t('dashboard.lesson.minutes', { count: lesson.durationMin })}
                    </span>
                  </span>
                  <Icon name="chevron-right" size={18} class="text-stone-500" />
                </a>
              </li>
            );
          })}
        </ol>
      </section>
      <aside class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start">
        <div class="rounded-card bg-surface-raised p-6 shadow-soft ring-1 ring-line">
          <p class="text-3xl font-bold">{percent}%</p>
          <ProgressBar value={percent} label={t('dashboard.courses.progress', { percent })} class="mt-3" />
          <p class="mt-2 text-sm text-fg-muted">
            {t('dashboard.courses.lessonsCount', { count: `${done} / ${lessons.length}` })}
          </p>
          {resume && (
            <a
              href={routes.dashboardLesson(lang, course.slug, resume.slug)}
              class={buttonClass('primary', 'lg', 'mt-6 w-full')}
            >
              {done === 0 ? t('dashboard.courses.start') : t('dashboard.courses.continue')}
              <Icon name="arrow-right" size={18} />
            </a>
          )}
        </div>
      </aside>
    </div>
  )}
</DashboardLayout>
