// Cloudflare Workers configuration (Workers + static assets).
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-academy-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs fall through to the Worker, which renders the localized 404 page.
    "not_found_handling": "none",
  },
  "observability": { "enabled": true },
  // Non-secret variables. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, ...) are set with
  // `wrangler secret put <NAME>` or in the Cloudflare dashboard. See DEPLOY.md.
  "vars": {},
  // Accounts, sessions and (later) subscriptions. Local dev uses a local SQLite copy in .wrangler/.
  // Before the first deploy: `npx wrangler d1 create nihongo-academy` and paste the real id below
  // (see DEPLOY.md), then `pnpm db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nihongo-academy",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations",
    },
  ],
}
