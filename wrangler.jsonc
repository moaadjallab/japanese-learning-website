// Cloudflare Workers configuration (Workers + static assets).
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo-academy-web",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs fall through to the Worker, which renders the localized 404 page.
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Non-secret variables. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, ...) are set with
  // `wrangler secret put <NAME>` or in the Cloudflare dashboard. See DEPLOY.md.
  "vars": {}
  // Future (V2): uncomment once the D1 database exists (see db/schema.sql and AUTH_PLAN.md).
  // "d1_databases": [{ "binding": "DB", "database_name": "nihongo-academy", "database_id": "<id>" }]
}
